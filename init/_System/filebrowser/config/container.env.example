FILEBROWSER_INITIAL_USERNAME=admin
FILEBROWSER_INITIAL_PASSWORD=admin
FILEBROWSER_IMAGE=filebrowser/filebrowser:latest
FILEBROWSER_ROOT=/srv
FILEBROWSER_MOUNTS='/mnt/usb-ef8d1024:/srv/usb_drive
/etc/config:/srv/etc_config
/data:/srv/data'
